{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nuvio-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  // Traces and invocation logs are off. Requests carry a bearer token, and
  // platform traces can capture headers. The Worker code does not log bodies
  // or tokens. See README.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "MAX_BODY_BYTES": "262144",
    "MAX_BLOBS": "50",
    "MAX_CIPHERTEXT_BYTES": "24576",
    "RATE_LIMIT_PER_WINDOW": "60",
    "RATE_WINDOW_MS": "600000",
    "PULL_DEFAULT_LIMIT": "100",
    "PULL_MAX_LIMIT": "100",
    "MAX_SPACE_BLOBS": "20000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuvio-sync",
      "database_id": "000cccae-d49d-421e-90f3-0316b310a89f",
      "migrations_dir": "migrations"
    }
  ]
}
